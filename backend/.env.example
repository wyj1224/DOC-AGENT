# PostgreSQL
DATABASE_URL=postgresql+psycopg://clause_agent:clause_agent@localhost:5432/clause_agent

# 登录认证
JWT_SECRET=change-me-before-running
JWT_EXPIRE_MINUTES=10080

# DeepSeek / LLM：用于 planner 和 final_answer
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 千问 / 阿里百炼：Embedding
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_EMBEDDING_MODEL=text-embedding-v3

# 千问视觉理解：PDF 公告条号和黑体强条证据识别
# 普通百炼账号可复用 QWEN_API_KEY；工作空间专属 Key 和地址则单独填写。
DASHSCOPE_API_KEY=
QWEN_VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_VISION_MODEL=qwen3.7-plus

# LlamaParse：用于知识库文档转 Markdown
LLAMA_CLOUD_API_KEY=

# Milvus
APP_MILVUS_URI=./data/milvus.db
MILVUS_COLLECTION=mandatory_clause_chunks
KNOWLEDGE_MILVUS_COLLECTION=knowledge_chunks
