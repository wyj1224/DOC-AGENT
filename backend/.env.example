# PostgreSQL
DATABASE_URL=postgresql+psycopg://clause_agent:clause_agent@localhost:5432/clause_agent

# 匿名访客 Cookie：用于隔离不同浏览器的会话、文档和 Agent 记忆
VISITOR_COOKIE_SECRET=change-me-before-running
VISITOR_COOKIE_DAYS=90
VISITOR_COOKIE_SECURE=false

# 管理员口令：保护强条库导入、模板上传/删除。公网部署必须设置；留空则不校验（仅限本地开发）
ADMIN_TOKEN=

# Docker Compose 中 PostgreSQL 的密码（compose 会读取本文件做变量替换）。公网部署必须修改
POSTGRES_PASSWORD=clause_agent

# DeepSeek / LLM：用于 ReAct 决策、Reflection 和最终报告
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
